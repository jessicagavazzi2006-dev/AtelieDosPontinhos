@model AtelieDosPontinhos.UI.Models.LoginViewModel

@{
    ViewData["Title"] = "Entrar";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 p-4 rounded-4">
                <h2 class="fw-bold mb-3 text-center text-primary">🔑 Acessar Minha Conta</h2>
                <p class="text-secondary text-center small mb-4">Insira suas credenciais para acompanhar seus pedidos.</p>

                <form asp-action="Login" method="post">

                    @* Exibição detalhada de erros vindo do Controller *@
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Endereço de E-mail</label>
                        <input asp-for="Email" class="form-control form-control-lg fs-6 shadow-none" placeholder="nome@exemplo.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    @* Campo: Senha com Olhinho *@
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Senha</label>
                        <div class="input-group">
                            <input asp-for="Password" id="loginPassword" type="password" class="form-control form-control-lg fs-6 border-end-0 shadow-none" placeholder="••••••••" required />
                            <button class="btn btn-outline-secondary border-start-0" type="button" onclick="togglePassword('loginPassword', this)">👁️</button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="RememberMe" class="form-check-input" style="cursor: pointer;" />
                        <label asp-for="RememberMe" class="form-check-label small" style="cursor: pointer;">
                            Lembrar-me neste dispositivo
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold shadow-sm mb-3">
                        Entrar
                    </button>

                    <div class="text-center">
                        <span class="text-secondary small">Ainda não tem uma conta?</span>
                        <a asp-action="Register" class="text-decoration-none small fw-bold text-primary ms-1">Cadastrar-se</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}