@model IEnumerable<AtelieDosPontinhos.UI.Models.ProductViewModel>

@{
    ViewData["Title"] = "Gerenciar Produtos";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-body m-0">
            <i class="bi bi-box-seam me-2" style="color: #b84a75;"></i> Gerenciar Produtos
        </h2>
        <!-- Redireciona para a Action de CriarProduto na Dashboard -->
        <a asp-controller="Dashboard" asp-action="CriarProduto" class="btn btn-primary rounded-pill px-4 shadow-sm fw-semibold" style="background-color: #b84a75; border-color: #b84a75;">
            <i class="bi bi-plus-lg me-1"></i> Novo Produto
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-secondary">
                    <tr>
                        <th style="width: 100px;" class="ps-3">Imagem</th>
                        <th>Nome</th>
                        <th>Preço</th>
                        <th>Descrição</th>
                        <th class="text-center pe-3">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    @{
                                        // Tratamento idêntico ao que funciona na página de Detalhes
                                        string imgUrl = "/images/produtos/default.png";

                                        // Verifique se a propriedade no seu loop de listagem é 'CoverImageUrl' ou 'ImagemUrl'
                                        // (baseado no print de Detalhes, a propriedade correta é CoverImageUrl)
                                        var rawImage = item.CoverImageUrl;

                                        if (!string.IsNullOrEmpty(rawImage))
                                        {
                                            if (rawImage.StartsWith("http://") || rawImage.StartsWith("https://") || rawImage.StartsWith("/"))
                                            {
                                                imgUrl = rawImage;
                                            }
                                            else
                                            {
                                                imgUrl = "/images/produtos/" + rawImage;
                                            }
                                        }
                                    }

                                    <img src="@imgUrl"
                                         class="card-img-top object-fit-cover"
                                         alt="@item.Nome"
                                         style="height: 220px;"
                                         onerror="this.onerror=null; this.src='/images/produtos/default.png';" />
                                </td>
                                <td class="fw-bold text-body">@item.Nome</td>
                                <td class="text-success fw-bold">@item.Preco.ToString("C")</td>
                                <td class="text-secondary text-truncate" style="max-width: 300px;">@item.Descricao</td>
                                <td class="text-center pe-3">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold">
                                            <i class="bi bi-pencil-square me-1"></i> Editar
                                        </a>
                                        <form asp-controller="Product" asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Deseja realmente excluir este produto?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
                                                <i class="bi bi-trash me-1"></i> Excluir
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-folder2-open display-6 mb-2 d-block"></i>
                                <p class="mb-0 fs-5">Nenhum produto cadastrado no momento.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>