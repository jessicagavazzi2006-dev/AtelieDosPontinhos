@model AtelieDosPontinhos.UI.Models.ProductViewModel

<div class="card">
    <div class="card-header bg-warning text-dark">
        <h4>📝 Editar Produto</h4>
    </div>
    <div class="card-body">

        <form asp-action="EditarProdutoPost" method="post" enctype="multipart/form-data">

            <!-- Campo oculto com o ID do produto -->
            <input type="hidden" asp-for="Id" />

            <!-- Campo: Nome do Produto -->
            <div class="form-group mb-3">
                <label class="form-label fw-bold">Nome do Produto</label>
                <input asp-for="Name" class="form-control" required />
            </div>

            <!-- Campo: Preço -->
            <div class="form-group mb-3">
                <label class="form-label fw-bold">Preço (R$)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" required />
            </div>

            <!-- Campo: Descrição do Produto -->
            <div class="form-group mb-3">
                <label class="form-label fw-bold">Descrição do Produto</label>
                <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
            </div>

            <!-- Campo: Categoria do Produto -->
            <div class="form-group mb-3">
                <label class="form-label fw-bold">Categoria</label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select" required>
                    <option value="">-- Selecione uma Categoria --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <!-- Campo: Destacar Produto (com sincronização explícita) -->
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" asp-for="Destaque" id="DestaqueCheck" onchange="syncDestaque(this.checked)" />
                <input type="hidden" asp-for="IsFeatured" id="IsFeaturedHidden" />
                <label class="form-check-label fw-bold" for="DestaqueCheck">⭐ Destacar este produto na página inicial</label>
            </div>

            <!-- Upload de Imagem do Computador -->
            <div class="form-group mb-3">
                <label class="form-label fw-bold">Imagem do Produto (Do Computador)</label>
                <input type="file" name="FotoArquivo" id="FotoArquivo" class="form-control" accept="image/*" onchange="previewImage(event)" />
                <small class="text-muted d-block mt-1">Selecione uma imagem JPG, PNG ou WebP.</small>
            </div>

            <!-- Pré-visualização da imagem atual/nova -->
            <div class="form-group mb-3 text-center">
                <label class="form-label d-block text-start fw-bold">Pré-visualização:</label>
                <img id="imagePreview" src="@Model.CoverImageUrl" alt="Pré-visualização" class="img-thumbnail" style="max-height: 200px; display: @(string.IsNullOrEmpty(Model.CoverImageUrl) ? "none" : "inline-block");" />
            </div>

            <!-- Guarda as URLs antigas e dados auxiliares para reenvio caso não alterados -->
            <input type="hidden" asp-for="CoverImageUrl" id="CoverImageUrl" />
            <input type="hidden" asp-for="ImagemUrl" />
            <input type="hidden" asp-for="Stock" />

            <div class="d-flex justify-content-between mt-4">
                <a asp-action="GerenciarProdutos" class="btn btn-secondary">Voltar</a>
                <button type="submit" class="btn btn-primary">Salvar Alterações</button>
            </div>

        </form>

    </div>
</div>

<!-- Scripts de Interatividade -->
<script>
    function previewImage(event) {
        var reader = new FileReader();
        reader.onload = function() {
            var output = document.getElementById('imagePreview');
            output.src = reader.result;
            output.style.display = 'inline-block';
        };
        if (event.target.files[0]) {
            reader.readAsDataURL(event.target.files[0]);
        }
    }

    function syncDestaque(isChecked) {
        var hiddenInput = document.getElementById('IsFeaturedHidden');
        if (hiddenInput) {
            hiddenInput.value = isChecked ? 'true' : 'false';
        }
    }

    // Executa no carregamento para garantir sincronia inicial entre Destaque e IsFeatured
    document.addEventListener("DOMContentLoaded", function() {
        var chk = document.getElementById('DestaqueCheck');
        if (chk) {
            syncDestaque(chk.checked);
        }
    });
</script>