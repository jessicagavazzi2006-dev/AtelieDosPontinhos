@model IEnumerable<AtelieDosPontinhos.UI.Models.ProductViewModel>

@{
    ViewData["Title"] = "Meus Favoritos";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold" style="color: #6f42c1;">❤️ Meus Favoritos</h2>
        <p class="text-muted">Produtos que você salvou para ver mais tarde</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 shadow-sm rounded bg-light">
            <div class="mb-3">
                <span style="font-size: 3rem;">💔</span>
            </div>
            <h4 class="text-secondary">Sua lista de favoritos está vazia</h4>
            <p class="text-muted">Você ainda não adicionou nenhum produto aos favoritos.</p>
            <a href="/" class="btn text-white mt-3 px-4 py-2" style="background-color: #6f42c1; border-radius: 8px;">
                <i class="bi bi-shop"></i> Explorar Produtos
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col" id="product-card-@item.Id">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden">
                        <div class="position-relative">
                            <img src="@(string.IsNullOrEmpty(item.CoverImageUrl) ? "/images/placeholder.jpg" : item.CoverImageUrl)"
                                 class="card-img-top"
                                 alt="@(string.IsNullOrEmpty(item.Nome) ? item.Name : item.Nome)"
                                 style="height: 220px; object-fit: cover;">
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <h5 class="card-title h6 fw-bold text-dark text-truncate">
                                @(string.IsNullOrEmpty(item.Nome) ? item.Name : item.Nome)
                            </h5>
                            <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @item.Descricao
                            </p>
                            <div class="mt-2">
                                <span class="fs-5 fw-bold text-success">
                                    R$ @item.Preco.ToString("N2")
                                </span>
                            </div>
                            <div class="d-flex gap-2 mt-3">
                                <a href="/Product/Detalhes/@item.Id" class="btn btn-sm btn-outline-primary w-100 py-2">
                                    Ver Detalhes
                                </a>
                                <button onclick="removerFavorito(@item.Id)" class="btn btn-sm btn-outline-danger px-3" title="Remover dos favoritos">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function removerFavorito(productId) {
            if (!confirm("Deseja remover este produto dos favoritos?")) return;

            fetch(`/Favorites/ToggleFavorite/${productId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Remove o card da tela dinamicamente sem recarregar a página
                        const card = document.getElementById(`product-card-${productId}`);
                        if (card) {
                            card.remove();
                        }
                        // Se não sobrou nenhum produto, recarrega para mostrar a mensagem de lista vazia
                        const restolista = document.querySelectorAll('[id^="product-card-"]');
                        if (restolista.length === 0) {
                            location.reload();
                        }
                    }
                })
                .catch(error => console.error('Erro ao remover dos favoritos:', error));
        }
    </script>
}