@model List<System.Text.Json.JsonElement>

@{
    ViewData["Title"] = "Meus Pedidos";
}

<div class="container py-5" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-body" style="color: #8a4f91 !important;">
            <i class="bi bi-bag-check-fill me-2"></i> Meus Pedidos Realizados
        </h2>
        <span class="badge rounded-pill bg-body-tertiary text-secondary border px-3 py-2 shadow-sm">
            <i class="bi bi-person-fill me-1"></i> @ViewBag.UserEmail
        </span>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-body">
            <div class="fs-1 text-muted mb-3">📦</div>
            <h4 class="fw-bold text-body">Você ainda não fez nenhum pedido.</h4>
            <p class="text-secondary small">Que tal dar uma olhada nas nossas peças artesanais e novidades do ateliê?</p>
            <div class="mt-3">
                <a asp-controller="Home" asp-action="Index" class="btn text-white rounded-pill px-4 fw-bold shadow-sm" style="background-color: #8a4f91;">
                    <i class="bi bi-bag-heart me-1"></i> Ir para a Vitrine
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var pedido in Model)
            {
                // Mapeamento seguro de propriedades (suporta Português e Inglês)
                int id = pedido.TryGetProperty("id", out var idP) ? idP.GetInt32() : (pedido.TryGetProperty("Id", out var idP2) ? idP2.GetInt32() : 0);

                string data = "-";
                if (pedido.TryGetProperty("dataPedido", out var dP) && dP.ValueKind != System.Text.Json.JsonValueKind.Null)
                    data = dP.GetDateTime().ToString("dd/MM/yyyy HH:mm");
                else if (pedido.TryGetProperty("createdDate", out var dP2) && dP2.ValueKind != System.Text.Json.JsonValueKind.Null)
                    data = dP2.GetDateTime().ToString("dd/MM/yyyy HH:mm");
                else if (pedido.TryGetProperty("dataCriacao", out var dP3) && dP3.ValueKind != System.Text.Json.JsonValueKind.Null)
                    data = dP3.GetDateTime().ToString("dd/MM/yyyy HH:mm");

                decimal total = 0m;
                if (pedido.TryGetProperty("valorTotal", out var tP)) total = tP.GetDecimal();
                else if (pedido.TryGetProperty("totalAmount", out var tP2)) total = tP2.GetDecimal();
                else if (pedido.TryGetProperty("total", out var tP3)) total = tP3.GetDecimal();

                string status = "Confirmado";
                if (pedido.TryGetProperty("status", out var stP) && stP.ValueKind != System.Text.Json.JsonValueKind.Null)
                    status = stP.GetString() ?? "Confirmado";

                string metodo = "Não informado";
                if (pedido.TryGetProperty("metodoPagamento", out var mP) && mP.ValueKind != System.Text.Json.JsonValueKind.Null)
                    metodo = mP.GetString() ?? "Não informado";
                else if (pedido.TryGetProperty("paymentMethod", out var mP2) && mP2.ValueKind != System.Text.Json.JsonValueKind.Null)
                    metodo = mP2.GetString() ?? "Não informado";

                // Converte caso venha código numérico legado
                if (metodo == "1") metodo = "Cartão de Crédito";
                else if (metodo == "2") metodo = "Cartão de Débito";
                else if (metodo == "3") metodo = "Pix";

                <div class="card border-0 shadow-sm p-4 rounded-4 bg-body mb-3 border-start border-4 border-success transition-all">
                    <div class="row align-items-center g-3">
                        <div class="col-6 col-md-3">
                            <span class="text-muted small d-block tracking-wider uppercase" style="font-size: 0.7rem;">NÚMERO DO PEDIDO</span>
                            <span class="fw-bold text-body fs-5">#@id.ToString("D4")</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-muted small d-block tracking-wider uppercase" style="font-size: 0.7rem;">DATA E HORA</span>
                            <span class="fw-semibold text-secondary small">@data</span>
                        </div>
                        <div class="col-6 col-md-2">
                            <span class="text-muted small d-block tracking-wider uppercase" style="font-size: 0.7rem;">PAGAMENTO</span>
                            <span class="badge bg-body-secondary text-body border px-2 py-1 fw-normal">@metodo</span>
                        </div>
                        <div class="col-6 col-md-2">
                            <span class="text-muted small d-block tracking-wider uppercase" style="font-size: 0.7rem;">VALOR TOTAL</span>
                            <span class="fw-bold text-success">@total.ToString("C")</span>
                        </div>
                        <div class="col-12 col-md-2 text-md-end">
                            <span class="text-muted small d-block text-md-end mb-1 tracking-wider uppercase" style="font-size: 0.7rem;">STATUS</span>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fw-bold">@status</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>