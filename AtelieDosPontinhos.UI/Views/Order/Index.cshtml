@model List<System.Text.Json.JsonElement>

@{
    ViewData["Title"] = "Meus Pedidos";
}

<div class="container py-5" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0" style="color: #8a4f91 !important;"><i class="bi bi-bag-check-fill"></i> Meus Pedidos Realizados</h2>
        <span class="badge rounded-pill bg-light text-secondary border px-3 py-2">👤 @ViewBag.UserEmail</span>
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
            <div class="fs-1 text-muted mb-3">📦</div>
            <h4 class="fw-bold text-secondary">Você ainda não fez nenhum pedido.</h4>
            <p class="text-muted small">Que tal dar uma olhada nas nossas toalhas e fraldas artesanais?</p>
            <div class="mt-3">
                <a asp-controller="Home" asp-action="Index" class="btn text-white rounded-pill px-4 fw-bold" style="background-color: #8a4f91;">Ir para a Vitrine</a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var pedido in Model)
            {
                var id = pedido.GetProperty("id").GetInt32();
                var data = pedido.GetProperty("dataPedido").GetDateTime().ToString("dd/MM/yyyy HH:mm");
                var total = pedido.GetProperty("valorTotal").GetDecimal();
                var status = pedido.GetProperty("status").GetString();
                var metodo = pedido.GetProperty("metodoPagamento").GetString() == "3" ? "PIX" : "Cartão";
                var cidade = pedido.GetProperty("cidade").GetString();

                <div class="card border-0 shadow-sm p-4 rounded-4 bg-white mb-3 border-start border-4 border-success">
                    <div class="row align-items-center">
                        <div class="col-md-3">
                            <span class="text-muted small d-block">NÚMERO DO PEDIDO</span>
                            <span class="fw-bold text-dark fs-5">#@id.ToString("D4")</span>
                        </div>
                        <div class="col-md-3">
                            <span class="text-muted small d-block">DATA E HORA</span>
                            <span class="fw-semibold text-secondary">@data</span>
                        </div>
                        <div class="col-md-2">
                            <span class="text-muted small d-block">PAGAMENTO</span>
                            <span class="badge bg-light text-dark border px-2 py-1">@metodo</span>
                        </div>
                        <div class="col-md-2">
                            <span class="text-muted small d-block">VALOR TOTAL</span>
                            <span class="fw-bold text-success">R$ @total.ToString("N2")</span>
                        </div>
                        <div class="col-md-2 text-md-end">
                            <span class="text-muted small d-block text-md-end mb-1">STATUS</span>
                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1fw-bold">@status</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
