@using System.Text.Json
@model List<JsonElement>

@{
    ViewData["Title"] = "Painel de Controle de Vendas";
    decimal faturamentoTotal = 0;

    if (Model != null)
    {
        foreach (var p in Model)
        {
            if (p.TryGetProperty("valorTotal", out var v))
            {
                faturamentoTotal += v.GetDecimal();
            }
        }
    }
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="color: #8a4f91;">Painel de Controle de Vendas</h2>
            <p class="text-muted mb-0">Acompanhamento em tempo real de todas as ordens de serviço do Ateliê dos Pontinhos.</p>
        </div>
        <div class="card bg-light border-0 shadow-sm px-4 py-3 rounded-4">
            <span class="small text-muted fw-bold">💰 FATURAMENTO BRUTO TOTAL</span>
            <h3 class="fw-bold text-success mb-0">R$ @faturamentoTotal.ToString("N2")</h3>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-light text-secondary small fw-bold">
                    <tr>
                        <th class="py-3">PEDIDO</th>
                        <th class="py-3 text-start">COMPRADOR</th>
                        <th class="py-3">DATA</th>
                        <th class="py-3">LOCALIDADE</th>
                        <th class="py-3">PAGAMENTO</th>
                        <th class="py-3">TOTAL</th>
                        <th class="py-3">STATUS</th>
                        <th class="py-3">AÇÕES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var pedido in Model)
                        {
                            int id = pedido.GetProperty("id").GetInt32();
                            string email = pedido.TryGetProperty("emailUsuario", out var e) ? e.GetString()! : "Desconhecido";
                            string status = pedido.TryGetProperty("status", out var s) ? s.GetString()! : "Pendente";
                            string cidade = pedido.TryGetProperty("cidade", out var c) ? c.GetString()! : "São Paulo";
                            string estado = pedido.TryGetProperty("estado", out var est) ? est.GetString()! : "SP";
                            string pagamento = pedido.TryGetProperty("metodoPagamento", out var m) ? m.GetString()! : "Cartão";
                            decimal total = pedido.GetProperty("valorTotal").GetDecimal();
                            DateTime data = pedido.GetProperty("dataPedido").GetDateTime();

                            if (pagamento == "1") pagamento = "Cartão de Crédito";
                            else if (pagamento == "2") pagamento = "Cartão de Débito";
                            else if (pagamento == "3") pagamento = "PIX";

                            <tr>
                                <td class="fw-bold text-dark">#@id.ToString("D4")</td>
                                <td class="text-start text-truncate" style="max-width: 220px;" title="@email">
                                    <i class="bi bi-person-circle text-secondary me-1"></i> @email
                                </td>
                                <td class="small text-muted">@data.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="small fw-semibold">@cidade - @estado</td>
                                <td><span class="badge bg-light text-dark border px-2 py-1 rounded-pill">@pagamento</span></td>
                                <td class="fw-bold text-dark">R$ @total.ToString("N2")</td>
                                <td>
                                    <form asp-controller="Order" asp-action="AtualizarStatus" method="post" class="d-inline-block">
                                        <input type="hidden" name="id" value="@id" />
                                        <select name="status" onchange="this.form.submit()" class="form-select form-select-sm rounded-pill border-0 px-3 fw-bold @(status == "Concluído" ? "bg-success bg-opacity-10 text-success" : "bg-warning bg-opacity-10 text-warning")">
                                            <option value="Pendente" selected="@(status == "Pendente")">🟡 Pendente</option>
                                            <option value="Concluído" selected="@(status == "Concluído")">🟢 Concluído</option>
                                            <option value="Cancelado" selected="@(status == "Cancelado")">🔴 Cancelado</option>
                                        </select>
                                    </form>
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-purple rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalPedido-@id" style="color: #8a4f91; border-color: #8a4f91;">
                                        🔍 Detalhes
                                    </button>

                                    <!-- MODAL DE DETALHES -->
                                    <div class="modal fade text-start" id="modalPedido-@id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-header-title fw-bold" style="color: #8a4f91;">Detalhes do Pedido #@id.ToString("D4")</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body p-4">
                                                    @{
                                                        string numRua = pedido.TryGetProperty("numero", out var num) && num.ValueKind == JsonValueKind.String ? num.GetString()! : "";
                                                        string cepRua = pedido.TryGetProperty("cep", out var cp) && cp.ValueKind == JsonValueKind.String ? cp.GetString()! : "";
                                                        string compRua = pedido.TryGetProperty("complemento", out var comp) && comp.ValueKind == JsonValueKind.String ? comp.GetString()! : "";
                                                    }

                                                    <p class="mb-1 small"><strong>Cliente:</strong> @email</p>
                                                    <p class="mb-1 small"><strong>Data:</strong> @data.ToString("dd/MM/yyyy HH:mm")</p>
                                                    <p class="mb-3 small"><strong>Endereço:</strong> @cidade - @estado @(string.IsNullOrEmpty(numRua) ? "" : $", Nº {numRua}") @(string.IsNullOrEmpty(compRua) ? "" : $"({compRua})") @(string.IsNullOrEmpty(cepRua) ? "" : $"- CEP: {cepRua}")</p>

                                                    <h6 class="fw-bold border-bottom pb-2 mb-3">Itens Comprados</h6>
                                                    <ul class="list-group list-group-flush mb-3">
                                                        @if (pedido.TryGetProperty("itens", out var itensArr) && itensArr.ValueKind == JsonValueKind.Array)
                                                        {
                                                            foreach (var item in itensArr.EnumerateArray())
                                                            {
                                                                string nomeProd = item.TryGetProperty("nomeProduto", out var np) && np.ValueKind == JsonValueKind.String ? np.GetString()! : $"Produto #{item.GetProperty("productId").GetInt32()}";
                                                                int qtd = item.GetProperty("quantidade").GetInt32();
                                                                decimal preco = item.GetProperty("precoUnitario").GetDecimal();

                                                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                                                    <span><strong class="text-dark">@nomeProd</strong> <small class="text-muted">(x@(qtd))</small></span>
                                                                    <span class="fw-semibold text-dark">R$ @((preco * qtd).ToString("N2"))</span>
                                                                </li>
                                                            }
                                                        }
                                                    </ul>
                                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                                        <span class="fw-bold">Total do Pedido:</span>
                                                        <span class="fw-bold fs-5 text-success">R$ @total.ToString("N2")</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="py-4 text-muted">Nenhum pedido encontrado.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>