@model List<System.Text.Json.JsonElement>

@{
    ViewData["Title"] = "Painel Administrativo de Vendas";

    // Cálculo seguro do faturamento total (trata 'valorTotal', 'totalAmount' ou 'total')
    decimal faturamentoTotal = 0m;
    if (Model != null)
    {
        foreach (var p in Model)
        {
            if (p.TryGetProperty("valorTotal", out var v1)) faturamentoTotal += v1.GetDecimal();
            else if (p.TryGetProperty("totalAmount", out var v2)) faturamentoTotal += v2.GetDecimal();
            else if (p.TryGetProperty("total", out var v3)) faturamentoTotal += v3.GetDecimal();
        }
    }
}

<div class="container py-5" style="max-width: 1100px;">
    <div class="row g-4 mb-4">
        <div class="col-md-8">
            <h2 class="fw-bold mb-1" style="color: #8a4f91 !important;"><i class="bi bi-shield-lock-fill"></i> Painel de Controle de Vendas</h2>
            <p class="text-muted mb-0 small">Acompanhamento em tempo real de todas as ordens de serviço do Ateliê dos Pontinhos.</p>
        </div>
        <!-- Card de Faturamento Centralizado -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 bg-success bg-opacity-10 rounded-4 text-end">
                <span class="text-secondary small fw-semibold">💰 FATURAMENTO BRUTO TOTAL</span>
                <h3 class="fw-bold text-success mb-0">R$ @faturamentoTotal.ToString("N2")</h3>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-dark">
                <thead class="table-light text-secondary small fw-semibold">
                    <tr>
                        <th class="ps-4 py-3">PEDIDO</th>
                        <th class="py-3">COMPRADOR</th>
                        <th class="py-3">DATA</th>
                        <th class="py-3">LOCALIDADE</th>
                        <th class="py-3">PAGAMENTO</th>
                        <th class="py-3">TOTAL</th>
                        <th class="py-3 text-center">STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">Nenhuma venda registrada no banco de dados ainda.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var pedido in Model)
                        {
                            // Parse seguro de ID
                            int id = pedido.TryGetProperty("id", out var idP) ? idP.GetInt32() : (pedido.TryGetProperty("Id", out var idP2) ? idP2.GetInt32() : 0);

                            // Parse seguro de Usuário/Email
                            string user = "-";
                            if (pedido.TryGetProperty("userEmail", out var u1)) user = u1.GetString() ?? "-";
                            else if (pedido.TryGetProperty("emailUsuario", out var u2)) user = u2.GetString() ?? "-";
                            else if (pedido.TryGetProperty("userId", out var u3)) user = u3.GetString() ?? "-";

                            // Parse seguro de Data
                            string data = "-";
                            if (pedido.TryGetProperty("dataPedido", out var d1) && d1.ValueKind != System.Text.Json.JsonValueKind.Null) data = d1.GetDateTime().ToString("dd/MM/yyyy HH:mm");
                            else if (pedido.TryGetProperty("createdDate", out var d2) && d2.ValueKind != System.Text.Json.JsonValueKind.Null) data = d2.GetDateTime().ToString("dd/MM/yyyy HH:mm");
                            else if (pedido.TryGetProperty("dataCriacao", out var d3) && d3.ValueKind != System.Text.Json.JsonValueKind.Null) data = d3.GetDateTime().ToString("dd/MM/yyyy HH:mm");

                            // Parse seguro de Cidade e Estado
                            string cidade = pedido.TryGetProperty("cidade", out var cP) ? (cP.GetString() ?? "") : "";
                            string estado = pedido.TryGetProperty("estado", out var eP) ? (eP.GetString() ?? "") : "";
                            string localidade = string.IsNullOrEmpty(cidade) ? "Não informada" : $"{cidade} - {estado}";

                            // Parse seguro do Pagamento
                            string rawMetodo = "";
                            if (pedido.TryGetProperty("metodoPagamento", out var m1)) rawMetodo = m1.GetString() ?? "";
                            else if (pedido.TryGetProperty("paymentMethod", out var m2)) rawMetodo = m2.GetString() ?? "";
                            string metodo = (rawMetodo == "3" || rawMetodo.ToUpper() == "PIX") ? "PIX" : "Cartão";

                            // Parse seguro do Valor Total
                            decimal total = 0m;
                            if (pedido.TryGetProperty("valorTotal", out var t1)) total = t1.GetDecimal();
                            else if (pedido.TryGetProperty("totalAmount", out var t2)) total = t2.GetDecimal();
                            else if (pedido.TryGetProperty("total", out var t3)) total = t3.GetDecimal();

                            // Parse seguro do Status
                            string status = "Confirmado";
                            if (pedido.TryGetProperty("status", out var stP) && stP.ValueKind != System.Text.Json.JsonValueKind.Null) status = stP.GetString() ?? "Confirmado";

                            <tr>
                                <td class="ps-4 fw-bold">#@id.ToString("D4")</td>
                                <td class="text-muted small text-truncate" style="max-width: 180px;" title="@user">@user</td>
                                <td class="text-secondary small">@data</td>
                                <td class="fw-semibold text-secondary">@localidade</td>
                                <td><span class="badge bg-light text-dark border">@metodo</span></td>
                                <td class="fw-bold text-dark">R$ @total.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 fw-semibold">@status</span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>