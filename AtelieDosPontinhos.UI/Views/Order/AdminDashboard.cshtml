
@model List<System.Text.Json.JsonElement>

@{
    ViewData["Title"] = "Painel de Controle de Vendas";

    decimal faturamentoTotal = ViewBag.FaturamentoFiltrado != null ? (decimal)ViewBag.FaturamentoFiltrado : 0;
    string statusAtual = ViewBag.StatusFiltroAtual as string ?? "";
}

<div class="container py-4">
    <div class="row align-items-center mb-4 gy-3">
        <div class="col-12 col-lg-6">
            <h2 class="fw-bold fs-3" style="color: #8a4f91;">Painel de Controle de Vendas</h2>
            <p class="text-muted mb-0 small">Acompanhamento em tempo real de todas as ordens de serviço do Ateliê dos Pontinhos.</p>
        </div>

        <div class="col-12 col-lg-6 d-flex flex-wrap justify-content-lg-end align-items-center gap-2">
            <form method="get" asp-action="AdminDashboard" class="mb-0">
                <select name="statusFiltro" onchange="this.form.submit()" class="form-select form-select-sm rounded-pill border shadow-sm fw-bold text-secondary" style="min-width: 175px; padding-right: 2.5rem !important;">
                    <option value="">🔍 Todos os Status</option>
                    <option value="Pendente" selected="@(statusAtual == "Pendente")">🟡 Pendente</option>
                    <option value="Concluído" selected="@(statusAtual == "Concluído")">🟢 Concluído</option>
                    <option value="Cancelado" selected="@(statusAtual == "Cancelado")">🔴 Cancelado</option>
                </select>
            </form>

            <div class="card bg-light border-0 shadow-sm px-3 py-2 rounded-4 mb-0">
                <span class="small text-muted fw-bold" style="font-size: 10px;">💰 FATURAMENTO (@(string.IsNullOrEmpty(statusAtual) ? "TOTAL" : statusAtual.ToUpper()))</span>
                <h3 class="fw-bold text-success mb-0 fs-5">R$ @faturamentoTotal.ToString("N2")</h3>
            </div>
        </div>
    </div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3" role="alert">
            @TempData["Sucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Erro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
            @TempData["Erro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-center">
                <thead class="bg-light text-secondary small fw-bold">
                    <tr>
                        <th class="py-3 px-2" style="width: 8%;">PEDIDO</th>
                        <th class="py-3 px-2 text-start" style="width: 22%;">COMPRADOR</th>
                        <th class="py-3 px-2" style="width: 14%;">DATA</th>
                        <th class="py-3 px-2" style="width: 12%;">LOCALIDADE</th>
                        <th class="py-3 px-2" style="width: 14%;">PAGAMENTO</th>
                        <th class="py-3 px-2" style="width: 10%;">TOTAL</th>
                        <th class="py-3 px-2" style="width: 10%;">STATUS</th>
                        <th class="py-3 px-2" style="width: 10%;">AÇÕES</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var pedido in Model)
                        {
                            int id = pedido.TryGetProperty("id", out var idProp) ? idProp.GetInt32() : 0;
                            string email = pedido.TryGetProperty("emailUsuario", out var e) ? e.GetString()! : "Desconhecido";
                            string status = pedido.TryGetProperty("status", out var s) ? s.GetString()! : (pedido.TryGetProperty("Status", out var s2) ? s2.GetString()! : "Pendente");
                            string cidade = pedido.TryGetProperty("cidade", out var c) ? c.GetString()! : "São Paulo";
                            string estado = pedido.TryGetProperty("estado", out var est) ? est.GetString()! : "SP";

                            string pagamento = "Não informado";
                            if (pedido.TryGetProperty("metodoPagamento", out var m) && m.ValueKind != System.Text.Json.JsonValueKind.Null)
                                pagamento = m.GetString() ?? "Não informado";
                            else if (pedido.TryGetProperty("paymentMethod", out var m2) && m2.ValueKind != System.Text.Json.JsonValueKind.Null)
                                pagamento = m2.GetString() ?? "Não informado";

                            decimal total = 0;
                            if (pedido.TryGetProperty("valorTotal", out var vt)) total = vt.GetDecimal();
                            else if (pedido.TryGetProperty("Total", out var vt2)) total = vt2.GetDecimal();

                            DateTime data = DateTime.Now;
                            if (pedido.TryGetProperty("dataPedido", out var dp)) data = dp.GetDateTime();
                            else if (pedido.TryGetProperty("Data", out var dp2)) data = dp2.GetDateTime();

                            if (pagamento == "1") pagamento = "Cartão de Crédito";
                            else if (pagamento == "2") pagamento = "Cartão de Débito";
                            else if (pagamento == "3") pagamento = "PIX";

                            <tr>
                                <td class="fw-bold text-dark px-2">#@id.ToString("D4")</td>
                                <td class="text-start text-truncate px-2" style="max-width: 180px;" title="@email">
                                    <i class="bi bi-person-circle text-secondary me-1"></i> @email
                                </td>
                                <td class="small text-muted px-2">@data.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="small fw-semibold px-2">@cidade - @estado</td>
                                <td class="px-2"><span class="badge bg-light text-dark border px-2 py-1 rounded-pill">@pagamento</span></td>
                                <td class="fw-bold text-dark px-2">R$ @total.ToString("N2")</td>
                                <td class="px-2">
                                    <form asp-controller="Order" asp-action="AtualizarStatus" method="post" class="d-inline-block">
                                        <input type="hidden" name="id" value="@id" />
                                        <select name="status" onchange="this.form.submit()"
                                                class="form-select form-select-sm rounded-pill border-0 ps-3 pe-4 fw-bold @(status == "Concluído" ? "bg-success bg-opacity-10 text-success" : status == "Cancelado" ? "bg-danger bg-opacity-10 text-danger" : "bg-warning bg-opacity-10 text-warning")"
                                                style="min-width: 130px;">
                                            <option value="Pendente" selected="@(status == "Pendente")">🟡 Pendente</option>
                                            <option value="Concluído" selected="@(status == "Concluído")">🟢 Concluído</option>
                                            <option value="Cancelado" selected="@(status == "Cancelado")">🔴 Cancelado</option>
                                        </select>
                                    </form>
                                </td>
                                <td class="px-2">
                                    <button type="button" class="btn btn-sm btn-outline-purple rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalPedido-@id" style="color: #8a4f91; border-color: #8a4f91;">
                                        🔍 Detalhes
                                    </button>

                                    <!-- MODAL DE DETALHES -->
                                    <div class="modal fade text-start" id="modalPedido-@id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-header-title fw-bold" style="color: #8a4f91;">Detalhes do Pedido #@id.ToString("D4")</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body p-4">
                                                    @{
                                                        string numRua = pedido.TryGetProperty("numero", out var num) && num.ValueKind == System.Text.Json.JsonValueKind.String ? num.GetString()! : "";
                                                        string cepRua = pedido.TryGetProperty("cep", out var cp) && cp.ValueKind == System.Text.Json.JsonValueKind.String ? cp.GetString()! : "";
                                                        string compRua = pedido.TryGetProperty("complemento", out var comp) && comp.ValueKind == System.Text.Json.JsonValueKind.String ? comp.GetString()! : "";
                                                    }

                                                    <p class="mb-1 small"><strong>Cliente:</strong> @email</p>
                                                    <p class="mb-1 small"><strong>Data:</strong> @data.ToString("dd/MM/yyyy HH:mm")</p>
                                                    <p class="mb-3 small"><strong>Endereço:</strong> @cidade - @estado @(string.IsNullOrEmpty(numRua) ? "" : $", Nº {numRua}") @(string.IsNullOrEmpty(compRua) ? "" : $"({compRua})") @(string.IsNullOrEmpty(cepRua) ? "" : $"- CEP: {cepRua}")</p>

                                                    <h6 class="fw-bold border-bottom pb-2 mb-3">Itens Comprados</h6>
                                                    <ul class="list-group list-group-flush mb-3">
                                                        @if (pedido.TryGetProperty("itens", out var itensArr) && itensArr.ValueKind == System.Text.Json.JsonValueKind.Array)
                                                        {
                                                            foreach (var item in itensArr.EnumerateArray())
                                                            {
                                                                string nomeProd = item.TryGetProperty("nomeProduto", out var np) && np.ValueKind == System.Text.Json.JsonValueKind.String ? np.GetString()! : $"Produto #{item.GetProperty("productId").GetInt32()}";
                                                                int qtd = item.GetProperty("quantidade").GetInt32();
                                                                decimal preco = item.GetProperty("precoUnitario").GetDecimal();

                                                                <li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                                                    <span><strong class="text-dark">@nomeProd</strong> <small class="text-muted">(x@(qtd))</small></span>
                                                                    <span class="fw-semibold text-dark">R$ @((preco * qtd).ToString("N2"))</span>
                                                                </li>
                                                            }
                                                        }
                                                    </ul>
                                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                                        <span class="fw-bold">Total do Pedido:</span>
                                                        <span class="fw-bold fs-5 text-success">R$ @total.ToString("N2")</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="py-4 text-muted">Nenhum pedido encontrado.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

```