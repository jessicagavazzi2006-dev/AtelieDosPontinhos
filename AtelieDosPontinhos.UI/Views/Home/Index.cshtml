@model IEnumerable<AtelieDosPontinhos.UI.Models.ProductViewModel>

@{
    ViewData["Title"] = "Início";
}

<!-- Estilos Específicos da Página Inicial -->
<style>
    .hero-section {
        background: linear-gradient(135deg, #fdfbf7 0%, #f7eddf 100%);
        border-radius: 2rem;
        padding: 4rem 2rem;
        position: relative;
        overflow: hidden;
    }

    [data-bs-theme="dark"] .hero-section {
        background: linear-gradient(135deg, #1b1724 0%, #292036 100%);
    }

    .hero-badge {
        background-color: #fce8f0;
        color: #b84a75;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.5px;
        padding: 6px 16px;
        border-radius: 50px;
        display: inline-block;
    }

    [data-bs-theme="dark"] .hero-badge {
        background-color: #3d2433;
        color: #ff9eba;
    }

    .feature-card {
        background: var(--bs-body-bg);
        border: 1px solid var(--bs-border-color);
        border-radius: 1.25rem;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

    /* Estilo dos Botões de Categoria */
    .category-btn {
        background: transparent;
        border: none;
        padding: 0;
        cursor: pointer;
        width: 100%;
        text-align: center;
        transition: transform 0.2s ease;
    }

        .category-btn:hover {
            transform: translateY(-3px);
        }

    .category-circle {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background-color: #fce8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px auto;
        color: #b84a75;
        font-size: 2rem;
        transition: all 0.3s ease;
    }

    .category-btn:hover .category-circle,
    .category-btn.active .category-circle {
        background-color: #b84a75;
        color: #fff;
        box-shadow: 0 5px 15px rgba(184, 74, 117, 0.3);
    }

    [data-bs-theme="dark"] .category-circle {
        background-color: #3d2433;
        color: #ff9eba;
    }

    [data-bs-theme="dark"] .category-btn:hover .category-circle,
    [data-bs-theme="dark"] .category-btn.active .category-circle {
        background-color: #ff9eba;
        color: #17131f;
    }
</style>

<!-- Hero Section Principal -->
<section class="hero-section mb-5 shadow-sm">
    <div class="row align-items-center g-5">
        <div class="col-lg-6 text-center text-lg-start">
            <span class="hero-badge mb-3"><i class="bi bi-heart-fill me-1"></i> A Arte do Ponto Cruz</span>

            <h1 class="display-4 fw-bold lh-tight mb-3 text-body">
                Cada Ponto uma História, <br><span style="color: #b84a75;">Cada Peça um Amor</span>
            </h1>

            <p class="lead text-secondary mb-4">
                Passado de geração em geração, o ponto cruz transforma fios de algodão em pura poesia visual. Cada "X" cruzado à mão carrega tempo, paciência e carinho, eternizando histórias em enxovais, quadros e lembranças únicas para o seu lar.
            </p>
            <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                <a href="#produtos" class="btn btn-primary btn-lg rounded-pill px-4 fw-semibold shadow-sm" style="background-color: #b84a75; border-color: #b84a75;">
                    <i class="bi bi-bag-heart me-2"></i> Ver Catálogo
                </a>
                <a href="#about" class="btn btn-outline-secondary btn-lg rounded-pill px-4 fw-semibold">
                    Conhecer História
                </a>
            </div>
        </div>
        <div class="col-lg-6 text-center">
            <div class="position-relative">
                <img src="~/images/banner/banner.png" alt="Bordado em Ponto Cruz Artesanal" class="img-fluid banner-home" style="max-height: 400px;" onerror="this.src='https://images.unsplash.com/photo-1584100936595-c0654b55a2e2?q=80&w=800&auto=format&fit=crop';" />
            </div>
        </div>
    </div>
</section>

<!-- Barra de Benefícios / Selos de Qualidade -->
<section class="mb-5">
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="feature-card p-4 h-100">
                <div class="text-danger fs-3 mb-2"><i class="bi bi-patch-check-fill" style="color: #b84a75;"></i></div>
                <h5 class="fw-bold mb-1">100% Feito à Mão</h5>
                <p class="text-secondary small mb-0">Cada ponto "X" é executado com total dedicação e rigor no avesso perfeito.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card p-4 h-100">
                <div class="text-danger fs-3 mb-2"><i class="bi bi-gift-fill" style="color: #b84a75;"></i></div>
                <h5 class="fw-bold mb-1">Presentes com História</h5>
                <p class="text-secondary small mb-0">Transformamos monogramas, datas e memórias afetivas em tesouros bordados.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card p-4 h-100">
                <div class="text-danger fs-3 mb-2"><i class="bi bi-truck" style="color: #b84a75;"></i></div>
                <h5 class="fw-bold mb-1">Envio com Cuidado</h5>
                <p class="text-secondary small mb-0">Embalado com carinho e proteção para chegar impecável até as suas mãos.</p>
            </div>
        </div>
    </div>
</section>

<!-- Categorias Interativas -->
<section class="mb-5 py-4">
    <div class="text-center mb-4">
        <span class="text-uppercase tracking-wider text-muted small fw-bold">Explore por Categoria</span>
        <h3 class="fw-bold">Nossas Especialidades</h3>
        <div class="mt-2">
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 active filter-btn" data-category="todos">Ver Todos</button>
        </div>
    </div>

    <div class="row g-4 justify-content-center text-center">
        <div class="col-6 col-md-3">
            <button class="category-btn filter-btn" data-category="Cama">
                <div class="category-circle shadow-sm">
                    <i class="bi bi-moon-stars"></i>
                </div>
                <h6 class="fw-bold mb-0 text-body">Cama</h6>
                <small class="text-secondary">Enxovais & Conforto</small>
            </button>
        </div>
        <div class="col-6 col-md-3">
            <button class="category-btn filter-btn" data-category="Mesa">
                <div class="category-circle shadow-sm">
                    <i class="bi bi-cup-hot"></i>
                </div>
                <h6 class="fw-bold mb-0 text-body">Mesa</h6>
                <small class="text-secondary">Cozinha & Decoração</small>
            </button>
        </div>
        <div class="col-6 col-md-3">
            <button class="category-btn filter-btn" data-category="Banho">
                <div class="category-circle shadow-sm">
                    <i class="bi bi-droplet"></i>
                </div>
                <h6 class="fw-bold mb-0 text-body">Banho</h6>
                <small class="text-secondary">Toalhas & Cuidados</small>
            </button>
        </div>
        <div class="col-6 col-md-3">
            <button class="category-btn filter-btn" data-category="Infantil">
                <div class="category-circle shadow-sm">
                    <i class="bi bi-balloon"></i>
                </div>
                <h6 class="fw-bold mb-0 text-body">Infantil</h6>
                <small class="text-secondary">Bebês & Crianças</small>
            </button>
        </div>
    </div>
</section>

<!-- Seção de Produtos Dinâmicos (@Model) -->
<section id="produtos" class="mb-5 pt-3">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <span class="text-uppercase tracking-wider text-muted small fw-bold">Catálogo Disponível</span>
            <h2 class="fw-bold mb-0">Nossos Produtos</h2>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4" id="lista-produtos">
            @foreach (var produto in Model)
            {
                var catProduto = string.IsNullOrEmpty(produto.Categoria) ? "Outros" : produto.Categoria.Trim();

                <div class="col produto-item" data-category="@catProduto">
                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden position-relative feature-card">

                        <!-- Badge de Destaque -->
                        <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill shadow-sm" style="background-color: #b84a75 !important; z-index: 2;">
                            Destaque
                        </span>

                        <!-- Imagem do Produto -->
                        <div class="bg-body-secondary position-relative overflow-hidden" style="height: 220px;">
                            @{
                                string imgUrl = "/images/products/default.png";
                                var rawImage = produto.CoverImageUrl;

                                if (!string.IsNullOrEmpty(rawImage))
                                {
                                    if (rawImage.StartsWith("http://") || rawImage.StartsWith("https://") || rawImage.StartsWith("/"))
                                    {
                                        imgUrl = rawImage;
                                    }
                                    else
                                    {
                                        imgUrl = "/images/products/" + rawImage;
                                    }
                                }
                            }
                            <img src="@imgUrl"
                                 class="w-100 h-100 object-fit-cover"
                                 alt="@produto.Nome"
                                 onerror="this.onerror=null; this.src='/images/products/default.png';" />
                        </div>

                        <!-- Corpo do Card -->
                        <div class="card-body d-flex flex-column p-4">
                            <h5 class="card-title fw-bold text-body mb-2 text-truncate">@produto.Nome</h5>
                            <p class="card-text text-secondary small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @produto.Descricao
                            </p>

                            <div class="d-flex align-items-center justify-content-between mt-3 pt-3 border-top">
                                <div>
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">Valor</small>
                                    <span class="fw-bold fs-5 text-success">@produto.Preco.ToString("C")</span>
                                </div>
                                <a asp-controller="Product" asp-action="Detalhes" asp-route-id="@produto.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold" style="border-color: #b84a75; color: #b84a75;">
                                    Ver Detalhes
                                </a>
                            </div>

                            <button type="button" class="btn btn-primary w-100 mt-3 rounded-pill fw-semibold shadow-sm add-to-cart" data-id="@produto.Id" style="background-color: #b84a75; border: none;">
                                <i class="bi bi-bag-plus me-1"></i> Adicionar ao Carrinho
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div id="no-products-msg" class="text-center py-5 bg-body-tertiary rounded-4 border d-none">
            <i class="bi bi-search display-4 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold text-secondary">Nenhum produto encontrado nesta categoria</h4>
            <p class="text-muted small">Tente selecionar outra categoria ou volte mais tarde!</p>
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-body-tertiary rounded-4 border">
            <i class="bi bi-basket display-4 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold text-secondary">Nenhum produto cadastrado no momento</h4>
            <p class="text-muted small">Volte em breve para conferir as novidades do ateliê!</p>
        </div>
    }
</section>

<!-- Seção Quem Somos / A História do Ponto Cruz -->
<section id="about" class="my-5 py-5 border-top border-bottom">
    <div class="row align-items-center g-5">
        <div class="col-lg-6 text-center">
            <img src="~/images/logo/logo.png" alt="Ateliê dos Pontinhos" class="img-fluid sobre-img p-4 bg-body-tertiary" style="max-height: 400px; width: 100%; object-fit: contain;" />
        </div>
        <div class="col-lg-6">
            <span class="hero-badge mb-3"><i class="bi bi-heart-fill me-1"></i> Nossa História com o Ponto Cruz</span>
            <h2 class="fw-bold mb-3">Da tradição milenar à delicadeza contemporânea</h2>
            <p class="text-secondary mb-3">
                O ponto cruz é uma das formas de bordado mais antigas da humanidade, encontrado desde trajes reais na Idade Média até enxovais tradicionais bordados por avós em tardes aconchegantes. A mágica acontece na simplicidade geométrica de cada "X", onde linhas coloridas cruzam o tecido criando texturas e formas vivas.
            </p>
            <p class="text-secondary mb-4">
                No <strong>Ateliê dos Pontinhos</strong>, resgatamos essa herança afetiva unindo o encanto clássico do ponto cruz a designs modernos e exclusivos. Acreditamos que cada peça feita à mão desacelera o tempo e eterniza sentimentos que nenhuma máquina consegue replicar.
            </p>
            <div class="d-flex gap-4">
                <div>
                    <h3 class="fw-bold mb-0 text-dark" style="color: #b84a75 !important;">+500</h3>
                    <small class="text-secondary">Peças Entregues</small>
                </div>
                <div class="vr opacity-25"></div>
                <div>
                    <h3 class="fw-bold mb-0 text-dark" style="color: #b84a75 !important;">100%</h3>
                    <small class="text-secondary">Feito à Mão</small>
                </div>
                <div class="vr opacity-25"></div>
                <div>
                    <h3 class="fw-bold mb-0 text-dark" style="color: #b84a75 !important;">5★</h3>
                    <small class="text-secondary">Avaliações</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Scripts de Filtro por Categoria e Carrinho -->
@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const filterButtons = document.querySelectorAll(".filter-btn");
            const productItems = document.querySelectorAll(".produto-item");
            const noProductsMsg = document.getElementById("no-products-msg");

            filterButtons.forEach(button => {
                button.addEventListener("click", function () {
                    filterButtons.forEach(btn => btn.classList.remove("active"));
                    this.classList.add("active");

                    const selectedCategory = this.getAttribute("data-category");
                    let visibleCount = 0;

                    productItems.forEach(item => {
                        const itemCategory = item.getAttribute("data-category");

                        if (selectedCategory === "todos" || itemCategory.toLowerCase() === selectedCategory.toLowerCase()) {
                            item.style.display = "block";
                            visibleCount++;
                        } else {
                            item.style.display = "none";
                        }
                    });

                    if (noProductsMsg) {
                        if (visibleCount === 0) {
                            noProductsMsg.classList.remove("d-none");
                        } else {
                            noProductsMsg.classList.add("d-none");
                        }
                    }
                });
            });

            const cartButtons = document.querySelectorAll(".add-to-cart");
            cartButtons.forEach(button => {
                button.addEventListener("click", async function () {
                    const productId = this.getAttribute("data-id");
                    try {
                        const response = await fetch('/Cart/AdicionarAoCarrinhoAjax', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ produtoId: parseInt(productId), quantidade: 1 })
                        });

                        if (response.ok) {
                            const data = await response.json();
                            if (data.success) {
                                const badge = document.getElementById("cartCount");
                                if (badge && data.totalItens !== undefined) {
                                    badge.innerText = data.totalItens;
                                }

                                // Dispara o Toast do Bootstrap em vez do alert()
                                const toastElement = document.getElementById('liveToast');
                                if (toastElement) {
                                    const toast = new bootstrap.Toast(toastElement);
                                    toast.show();
                                }
                            } else {
                                console.error("Erro retornado:", data.message);
                            }
                        }
                    } catch (error) {
                        console.error("Erro ao adicionar ao carrinho:", error);
                    }
                });
            });
        });
    </script>
}
}