@model IEnumerable<AtelieDosPontinhos.UI.Models.ProductViewModel>

@{
    ViewData["Title"] = "Página Inicial";
}

<div class="container mt-3">
    <div id="carouselHome" class="carousel slide shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/banner/banner.png" class="d-block w-100 banner-home" style="height: 400px; object-fit: cover;" alt="Banner 1" />
            </div>
            <div class="carousel-item">
                <img src="~/images/banner/Banner2.png" class="d-block w-100 banner-home" style="height: 400px; object-fit: cover;" alt="Banner 2" />
            </div>
            <div class="carousel-item">
                <img src="~/images/banner/Banner3.jpg" class="d-block w-100 banner-home" style="height: 400px; object-fit: cover;" alt="Banner 3" />
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselHome" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselHome" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
        </button>
    </div>
</div>

<div class="container mt-5 mb-5">
    <h2 class="text-center mb-4 fw-bold text-secondary">Nossos Produtos</h2>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden position-relative">

                        <!-- 🤍 Botão Favoritar Flutuante sobre a imagem -->
                        <button type="button"
                                onclick="toggleFavoritoHome(@item.Id, this)"
                                class="btn btn-light rounded-circle position-absolute top-0 end-0 m-2 shadow-sm d-flex align-items-center justify-content-center"
                                style="width: 38px; height: 38px; z-index: 10; border: none; background-color: rgba(255, 255, 255, 0.9);"
                                title="Favoritar">
                            <i class="bi bi-heart text-danger fs-5"></i>
                        </button>

                        <a href="/Product/Detalhes/@item.Id" class="text-decoration-none">
                            <img src="@item.CoverImageUrl" class="card-img-top" alt="@item.Name" style="height: 250px; object-fit: cover;">
                        </a>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark">
                                <a href="/Product/Detalhes/@item.Id" class="text-decoration-none text-dark">
                                    @(string.IsNullOrEmpty(item.Nome) ? item.Name : item.Nome)
                                </a>
                            </h5>
                            <p class="card-text text-muted text-truncate">@item.Descricao</p>
                            <p class="card-text fs-5 fw-bold text-success mt-auto">R$ @item.Price</p>

                            <!-- Botão AJAX que adiciona sem sair da página -->
                            <button type="button" onclick="adicionarAoCarrinhoHome(@item.Id)" class="btn btn-outline-primary w-100 rounded-pill fw-bold mt-3">
                                <i class="bi bi-cart-plus-fill"></i> Adicionar ao Carrinho
                            </button>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <p class="text-muted fs-5">Nenhum produto encontrado no momento.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>

    <script>
        function adicionarAoCarrinhoHome(productId) {
            const formData = new FormData();
            formData.append('id', productId);
            formData.append('quantidade', 1);

            fetch('/Cart/AdicionarAoCarrinhoAjax', {
                method: 'POST',
                body: formData
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const cartBadge = document.getElementById("cartCount");
                        if (cartBadge) {
                            cartBadge.innerText = data.totalCount;
                        }
                    } else {
                        alert(data.message || 'Erro ao adicionar item ao carrinho.');
                    }
                })
                .catch(error => console.error('Erro ao adicionar ao carrinho:', error));
        }

        function toggleFavoritoHome(productId, btnElement) {
            const icone = btnElement.querySelector('i');

            fetch(`/Favorites/ToggleFavorite/${productId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(response => {
                    if (!response.ok) throw new Error('Erro na requisição');
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        if (data.isFavorited) {
                            icone.className = 'bi bi-heart-fill text-danger fs-5';
                        } else {
                            icone.className = 'bi bi-heart text-danger fs-5';
                        }
                    }
                })
                .catch(error => console.error('Erro ao alternar favorito:', error));
        }
    </script>
}