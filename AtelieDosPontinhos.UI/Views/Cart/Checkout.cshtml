@model List<AtelieDosPontinhos.UI.Models.CartItemViewModel>

@{
    ViewData["Title"] = "Finalizar Pedido";
    decimal totalGeral = 0;
}

<div class="container py-5" style="max-width: 950px;">
    <h2 class="fw-bold mb-4" style="color: #8a4f91 !important;">🏁 Finalizar Meu Pedido</h2>

    <form asp-controller="Cart" asp-action="ConfirmarPedidoPost" method="post">
        <div class="row g-4">

            <!-- COLUNA DA ESQUERDA: INFORMAÇÕES DO CLIENTE -->
            <div class="col-md-7">

                <!-- Bloco 1: Dados de Entrega (🌟 VINDO DIREITO DO C#) -->
                <div class="card shadow-sm border-0 p-4 rounded-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3" style="color: #8a4f91;"><i class="bi bi-geo-alt-fill"></i> 📍 Endereço de Entrega</h5>
                    <p class="text-muted small mb-3">Confirme ou altere os dados para o envio dos seus produtos artesanais:</p>

                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label text-secondary small fw-semibold">E-mail do Destinatário</label>
                            <input type="text" class="form-control bg-light border-0 rounded-pill px-3" value="@ViewBag.UserEmail" readonly />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-secondary small fw-semibold">CEP</label>
                            <input type="text" name="CEP" class="form-control bg-light border-0 rounded-pill px-3" value="@ViewBag.CEP" required />
                        </div>
                        <div class="col-md-5">
                            <label class="form-label text-secondary small fw-semibold">Cidade</label>
                            <input type="text" name="Cidade" class="form-control bg-light border-0 rounded-pill px-3" value="@ViewBag.Cidade" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-secondary small fw-semibold">Estado (UF)</label>
                            <input type="text" name="Estado" class="form-control bg-light border-0 rounded-pill px-3" value="@ViewBag.Estado" maxlength="2" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-secondary small fw-semibold">Número</label>
                            <input type="text" name="Numero" class="form-control bg-light border-0 rounded-pill px-3" value="@ViewBag.Numero" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label text-secondary small fw-semibold">Complemento / Referência</label>
                            <input type="text" name="Complemento" class="form-control bg-light border-0 rounded-pill px-3" value="@ViewBag.Referencial" placeholder="Apto, Bloco, Próximo a..." />
                        </div>
                    </div>
                </div>

                <!-- Bloco 2: Forma de Pagamento com Alternância Garantida -->
                <div class="card shadow-sm border-0 p-4 rounded-4 bg-white">
                    <h5 class="fw-bold mb-3" style="color: #8a4f91;"><i class="bi bi-credit-card-2-back-fill"></i> 💳 Forma de Pagamento</h5>
                    <p class="text-muted small mb-3">Selecione a modalidade de cobrança preferencial para o fechamento:</p>

                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label text-secondary small fw-semibold">Tipo de Pagamento</label>
                            <select name="TipoPagamento" id="selectPagamento" class="form-select bg-light border-0 rounded-pill px-3" onchange="alternarMetodoPagamento()">
                                <option value="1">💳 Cartão de Crédito</option>
                                <option value="2">💵 Cartão de Débito</option>
                                <option value="3">📱 PIX</option>
                            </select>
                        </div>

                        <!-- 💳 ÁREA DO CARTÃO -->
                        <div id="areaCartao" class="row g-3 col-md-12 m-0 p-0">
                            <div class="col-md-7">
                                <label class="form-label text-secondary small fw-semibold">Nome Impresso no Cartão</label>
                                <input type="text" name="NomeNoCartao" class="form-control bg-light border-0 rounded-pill px-3" value="@ViewBag.NomeNoCartao" placeholder="Ex: ANA S SILVA" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label text-secondary small fw-semibold">Número do Cartão </label>
                                <input type="text" id="inputCartao" name="NumeroCartaoMascarado" class="form-control bg-light border-0 rounded-pill px-3" value="@ViewBag.NumeroCartao" maxlength="19" placeholder="4532 0000 0000 4321" />
                            </div>
                        </div>

                        <!-- 📱 ÁREA DO PIX (INCLUI NOME DO ATELIÊ E CNPJ COMPLETO) -->
                        <div id="areaPix" class="col-md-12 text-center py-3 d-none">
                            <div class="p-4 rounded-4 border bg-light d-inline-block shadow-sm" style="max-width: 320px;">
                                <p class="fw-bold text-dark small mb-3">📱 Escaneie o QR Code abaixo para pagar:</p>

                                <div class="bg-white p-3 rounded-3 shadow-sm d-inline-block mb-3 border">
                                    <img src="https://qrserver.com" alt="QR Code PIX Ateliê" class="img-fluid" style="width: 160px; height: 160px;" />
                                </div>

                                <span class="d-block text-dark fw-bold mb-1" style="font-size: 14px;">Ateliê dos Pontinhos Ltda.</span>
                                <span class="d-block text-muted font-monospace mb-2" style="font-size: 12px;">CNPJ: 99.999.999/0001-99</span>
                                <small class="text-success fw-semibold bg-success bg-opacity-10 px-3 py-1 rounded-pill" style="font-size: 11px;"><i class="bi bi-shield-check"></i> Ambiente de Pagamento Seguro</small>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- COLUNA DA DIREITA: RESUMO FINANCEIRO -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm p-4 rounded-4 bg-light">
                    <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">Resumo dos Itens</h5>

                    <div class="mb-4" style="max-height: 250px; overflow-y: auto;">
                        @foreach (var item in Model)
                        {
                            var nomeProduto = item.Produto.GetType().GetProperty("Nome")?.GetValue(item.Produto)?.ToString()
                                              ?? item.Produto.GetType().GetProperty("Name")?.GetValue(item.Produto)?.ToString()
                                              ?? "Produto Artesanal";
                            var preco = Convert.ToDecimal(item.Produto.GetType().GetProperty("Preco")?.GetValue(item.Produto) ?? item.Produto.GetType().GetProperty("Price")?.GetValue(item.Produto));
                            var subtotal = preco * item.Quantidade;
                            totalGeral += subtotal;

                            <div class="d-flex justify-content-between align-items-center mb-3 text-dark fs-6">
                                <span class="text-truncate" style="max-width: 180px;">@nomeProduto <small class="text-muted">x@item.Quantidade</small></span>
                                <span class="fw-semibold text-secondary">R$ @subtotal.ToString("N2")</span>
                            </div>
                        }
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-3 border-top mb-4">
                        <h5 class="fw-bold text-dark mb-0">Total do Pedido:</h5>
                        <h4 class="fw-bold text-success mb-0">R$ @totalGeral.ToString("N2")</h4>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold py-3 shadow w-100">
                            🚀 Confirmar Pedido e Pagar
                        </button>
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-link text-decoration-none text-muted btn-sm mt-3">
                            Voltar ao Carrinho
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>


<!script type="text/javascript">
    function alternarMetodoPagamento() {
        var select = document.getElementById("selectPagamento");
        var areaCartao = document.getElementById("areaCartao");
        var areaPix = document.getElementById("areaPix");

        if (select && areaCartao && areaPix) {
            if (select.value === "3") {
                areaCartao.style.setProperty("display", "none", "important");
                areaPix.classList.remove("d-none");
                areaPix.style.setProperty("display", "block", "important");
            } else {
                areaCartao.style.setProperty("display", "flex", "important");
                areaPix.classList.add("d-none");
                areaPix.style.setProperty("display", "none", "important");
            }
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        var selectVal = "@ViewBag.MetodoSalvo";
        if (selectVal && selectVal !== "") {
            var selectElem = document.getElementById("selectPagamento");
            if (selectElem) {
                selectElem.value = selectVal;
            }
        }
        alternarMetodoPagamento();

        var inputCartao = document.getElementById("inputCartao");
        if(inputCartao) {
            inputCartao.addEventListener("input", function(e) {
                var v = e.target.value.replace(/\D/g, "");
                var m = v.match(/.{1,4}/g);
                if (m) { e.target.value = m.join(" "); }
            });
        }
    });
</!script>
