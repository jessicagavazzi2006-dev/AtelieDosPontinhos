<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ateliê dos Pontinhos</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Ícones do Bootstrap -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>

    @* 👥 Capturando as informações diretamente da Session para usar no Layout *@
    @{
        var userEmail = Context.Session.GetString("UserEmail");
        var userRoles = Context.Session.GetString("UserRoles") ?? "";
        var isLogged = !string.IsNullOrEmpty(userEmail);
        var isAdmin = userRoles.Split(',').Contains("Admin");
    }

    <header>
        <!-- Navbar fixa com sobreposição correta -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow fixed-top" style="z-index: 1030;">
            <div class="container">

                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo/logo.png" class="logo-navbar rounded-circle me-2" alt="Logo" style="width: 40px; height: 40px; object-fit: cover;" />
                    <strong>Ateliê dos Pontinhos</strong>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    </ul>

                    <div class="flex-grow-1 px-3 position-relative" style="max-width: 500px;">
                        <input type="search" class="form-control search-navbar" placeholder="Buscar produtos e categorias..." />
                        <div id="searchResults" class="list-group position-absolute w-100 mt-1 shadow" style="z-index:9999; display:none;"></div>
                    </div>

                    <div class="d-flex align-items-center gap-3 fs-5 ms-auto">

                        @* ❤️ Link direto para os Favoritos *@
                        <a asp-controller="Favorites" asp-action="Index" title="Meus Favoritos" class="text-decoration-none d-flex align-items-center fs-6 fw-semibold text-danger">
                            <i class="bi bi-heart-fill me-1"></i> Favoritos
                        </a>

                        @if (isLogged)
                        {
                            @* 👤 Menu Dropdown limpo para o usuário logado *@
                            <div class="dropdown">
                                <button class="btn btn-light dropdown-toggle border rounded-pill px-3 py-1 fs-6 d-flex align-items-center gap-2 bg-light text-dark fw-semibold shadow-sm" type="button" id="userMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-primary fs-5"></i>
                                    <span style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@userEmail.Split('@')[0]</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-3 py-2" aria-labelledby="userMenuButton">
                                    <li>
                                        <div class="px-3 py-1 text-muted small border-bottom mb-1">
                                            Logado como:<br><strong>@userEmail</strong>
                                        </div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 fw-semibold text-secondary" asp-controller="Order" asp-action="Index">
                                            📦 Meus Pedidos
                                        </a>
                                    </li>

                                    @if (isAdmin)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 fw-semibold" asp-controller="Order" asp-action="AdminDashboard" style="color: #8a4f91;">
                                                📋 Painel de Vendas
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 fw-semibold text-purple" asp-controller="Dashboard" asp-action="AdminPanel">
                                                🔐 Painel Admin
                                            </a>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item py-2 fw-semibold text-danger" asp-controller="Account" asp-action="Logout">
                                            🚪 Sair
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex gap-2 align-items-center me-1">
                                <a asp-controller="Account" asp-action="Login" class="text-decoration-none text-muted small fw-semibold fs-6">Entrar</a>
                                <span class="text-muted small fs-6">|</span>
                                <a asp-controller="Account" asp-action="Register" class="text-decoration-none text-primary small fw-bold fs-6">Cadastrar-se</a>
                            </div>
                            <a asp-controller="Account" asp-action="Login" title="Minha conta" class="text-decoration-none">👤</a>
                        }

                        <a asp-controller="Cart" asp-action="Index" class="position-relative text-decoration-none d-inline-block" style="cursor: pointer;">
                            <span title="Carrinho">🛒</span>
                            <span class="cart-badge badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill fs-6" id="cartCount">0</span>
                        </a>

                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- Margem superior ajustada para compensar a barra fixa -->
    <main class="container mt-4" style="margin-top: 85px !important;">
        @RenderBody()
    </main>

    <!-- 🍞 Container de Notificações Toast Flutuantes -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        <div id="liveToast" class="toast align-items-center text-white bg-success border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fs-6 fw-semibold" id="toastMessage">
                    🛒 Produto adicionado ao carrinho com sucesso!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            const input = document.querySelector(".search-navbar");
            const resultsBox = document.getElementById("searchResults");
            let timeout = null;

            input.addEventListener("input", function() {
                clearTimeout(timeout);
                const term = this.value.trim();

                if (term.length < 2) {
                    resultsBox.style.display = "none";
                    return;
                }

                timeout = setTimeout(async () => {
                    try {
                        const response = await fetch(`http://localhost:5006/api/Product/search?term=${encodeURIComponent(term)}`);

                        if (!response.ok) return;

                        const data = await response.json();
                        resultsBox.innerHTML = "";

                        if (!data || data.length === 0) {
                            resultsBox.style.display = "none";
                            return;
                        }

                        data.forEach(p => {
                            const productId = p.id || p.Id;
                            const productName = p.name || p.nome || p.Name || p.Nome;

                            if (productId) {
                                const item = document.createElement("a");
                                item.classList.add("list-group-item", "list-group-item-action", "py-2");
                                item.href = `/Product/Detalhes/${productId}`;
                                item.innerText = productName;

                                resultsBox.appendChild(item);
                            }
                        });

                        resultsBox.style.display = "block";
                    } catch (error) {
                        console.error("Erro na busca:", error);
                    }
                }, 300);
            });

            document.addEventListener("click", function(e) {
                if (!input.contains(e.target) && !resultsBox.contains(e.target)) {
                    resultsBox.style.display = "none";
                }
            });
    </script>

    <script>
            function updateCartCount() {
                @{
                        var cartJson = Context.Session.GetString("Carrinho");
                        int totalItens = 0;
                        if (!string.IsNullOrEmpty(cartJson))
                        {
                            try
                            {
                                var itens = System.Text.Json.JsonSerializer.Deserialize<List<AtelieDosPontinhos.UI.Models.CartItemViewModel>>(cartJson);
                                                totalItens = itens?.Sum(x => x.Quantidade) ?? 0;
                            }
                                        catch { }
                        }
                    }
                    document.getElementById("cartCount").innerText = "@totalItens";
            }

            document.addEventListener("DOMContentLoaded", updateCartCount);
    </script>

    <script>
            function togglePassword(inputId, button) {
                const input = document.getElementById(inputId);
                if (!input) return;

                if (input.type === "password") {
                    input.type = "text";
                    button.innerText = "🙈";
                } else {
                    input.type = "password";
                    button.innerText = "👁️";
                }
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>