<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Ateliê dos Pontinhos</title>

    <!-- Script Inline Precoce para Aplicar o Tema Salvo antes de renderizar (Evita piscar a tela) -->
    <script>
            (function () {
                const savedTheme = localStorage.getItem("theme") || "light";
                document.documentElement.setAttribute("data-bs-theme", savedTheme);
            })();
    </script>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Seu CSS Personalizado -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AtelieDosPontinhos.UI.styles.css" asp-append-version="true" />

    <!-- Estilo Sutil e Elegante para os Links do Rodapé -->
    <style>
            .footer-nav-link {
                display: inline-block;
                padding: 4px 10px;
                border-radius: 6px;
                transition: all 0.2s ease-in-out;
                color: var(--bs-secondary-color, #6c757d);
                text-decoration: none;
            }

                .footer-nav-link:hover {
                    background-color: #b84a75;
                    color: #ffffff !important;
                }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-lg border-bottom box-shadow mb-3 py-3 px-3 bg-body">
            <div class="container">

                <!-- Logo do Ateliê -->
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-body" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo/logo.png" alt="Ateliê dos Pontinhos" class="rounded-circle shadow-sm" style="width: 42px; height: 42px; object-fit: cover;" />
                    <span>Ateliê dos Pontinhos</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="navbarContent">

                    <!-- Barra de Busca Centralizada -->
                    <form class="d-flex mx-lg-auto my-2 my-lg-0" style="width: 100%; max-width: 400px;" asp-controller="Home" asp-action="Index" method="get">
                        <div class="input-group">
                            <span class="input-group-text bg-body-secondary border-end-0 rounded-start-pill ps-3 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input class="form-control bg-body-secondary border-start-0 rounded-end-pill ps-0 text-body shadow-none" type="search" placeholder="Buscar mimos, linhas, produtos..." aria-label="Search" name="busca">
                        </div>
                    </form>

                    <!-- Ações à Direita -->
                    <div class="d-flex align-items-center gap-3 ms-auto">

                        <!-- Botão Alternar Tema -->
                        <button type="button" id="btn-theme-toggle" class="btn btn-link text-body p-0 text-decoration-none fs-5" title="Alternar Tema">
                            <i class="bi bi-moon-fill" id="theme-icon"></i>
                        </button>

                        <!-- Favoritos -->
                        <a asp-controller="Favorites" asp-action="Index" class="btn btn-link text-body p-0 text-decoration-none fs-5 position-relative" title="Favoritos">
                            <i class="bi bi-heart"></i>
                        </a>

                        <!-- Carrinho -->
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-link text-body p-0 text-decoration-none fs-5 position-relative" title="Carrinho">
                            <i class="bi bi-bag"></i>
                            <span id="cartCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem; background-color: #b84a75 !important;">
                                @{
                                    var totalItens = ViewBag.TotalItensCarrinho != null ? ViewBag.TotalItensCarrinho : 0;
                                }
                                @totalItens
                            </span>
                        </a>

                        <!-- Botão Ver Catálogo -->
                        <a href="/#produtos" class="btn rounded-pill px-3 py-1 fw-semibold text-white shadow-sm d-none d-xl-inline-block" style="background-color: #b84a75; font-size: 0.9rem;">
                            <i class="bi bi-bag-heart me-1"></i> Ver Catálogo
                        </a>

                        <div class="vr opacity-25 mx-1"></div>

                        <!-- Autenticação Dinâmica Baseada em Sessão -->
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("UserEmail")))
                        {
                            var userEmail = Context.Session.GetString("UserEmail");
                            var userRoles = Context.Session.GetString("UserRoles") ?? "";
                            bool isAdmin = userRoles.Contains("Admin");

                            <!-- Menu Dropdown para Usuário Logado -->
                            <div class="dropdown">
                                <button class="btn btn-outline-secondary rounded-pill px-3 py-1 d-flex align-items-center gap-2 dropdown-toggle border" type="button" id="adminDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="border-color: var(--bs-border-color) !important;">
                                    <i class="bi bi-person-circle fs-5" style="color: #b84a75 !important;"></i>
                                    <span class="fw-semibold text-body">@userEmail</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-4 p-2 mt-2" aria-labelledby="adminDropdown" style="min-width: 230px;">
                                    <li class="px-3 py-2 border-bottom mb-2">
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">Logado como:</small>
                                        <span class="fw-bold text-body text-truncate d-block" style="font-size: 0.85rem;">@userEmail</span>
                                    </li>

                                    @if (isAdmin)
                                    {
                                        <!-- Opções exclusivas do Administrador corrigidas -->
                                        <li>
                                            <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="AdminPanel">
                                                <i class="bi bi-graph-up text-secondary"></i> Painel Administrativo
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" asp-controller="Order" asp-action="AdminDashboard">
                                                <i class="bi bi-box-seam text-secondary"></i> Painel de Vendas
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider my-2"></li>
                                    }

                                    <!-- Opções comuns (Perfil e Pedidos) -->
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person text-secondary"></i> Meu Perfil
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" asp-controller="Order" asp-action="Index">
                                            <i class="bi bi-box text-secondary"></i> Meus Pedidos
                                        </a>
                                    </li>

                                    <li><hr class="dropdown-divider my-2"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="w-100">
                                            <button type="submit" class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2 text-danger border-0 bg-transparent">
                                                <i class="bi bi-box-arrow-right"></i> Sair
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- Botão de Login para Visitantes -->
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary rounded-pill px-3 py-1 d-flex align-items-center gap-2 border" style="border-color: var(--bs-border-color) !important; font-size: 0.9rem;">
                                <i class="bi bi-person" style="color: #b84a75 !important;"></i>
                                <span class="fw-semibold text-body">Entrar</span>
                            </a>
                        }

                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Conteúdo Principal Envolvido em Container Centralizado -->
    <main role="main" class="flex-grow-1 pb-3">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Rodapé Organizado e com Caixa de Descrição Delimitada -->
    <footer class="border-top footer text-muted pt-5 pb-3 mt-auto bg-body">
        <div class="container">
            <div class="row g-4">

                <!-- Coluna 1: Logo, Box com Descrição e Redes Sociais -->
                <div class="col-lg-4 col-md-12 mb-4 mb-lg-0">
                    <div class="d-flex align-items-center gap-2 fw-bold text-body mb-3">
                        <img src="~/images/logo/logo.png" alt="Ateliê dos Pontinhos" class="rounded-circle shadow-sm" style="width: 36px; height: 36px; object-fit: cover;" />
                        <span>Ateliê dos Pontinhos</span>
                    </div>

                    <div class="mb-3" style="max-width: 280px;">
                        <p class="small text-muted mb-0" style="line-height: 1.5;">
                            Peças artesanais feitas à mão com carinho, dedicação e qualidade. O mimo perfeito para você e quem você ama.
                        </p>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="javascript:void(0);" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 36px; height: 36px; background-color: #b84a75;" title="Instagram">
                            <i class="bi bi-instagram fs-6"></i>
                        </a>
                        <a href="javascript:void(0);" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 36px; height: 36px; background-color: #b84a75;" title="WhatsApp">
                            <i class="bi bi-whatsapp fs-6"></i>
                        </a>
                        <a href="javascript:void(0);" class="btn btn-sm rounded-circle d-flex align-items-center justify-content-center text-white shadow-sm" style="width: 36px; height: 36px; background-color: #b84a75;" title="E-mail">
                            <i class="bi bi-envelope fs-6"></i>
                        </a>
                    </div>
                </div>

                <!-- Coluna 2: Navegação -->
                <div class="col-lg-4 col-md-6 mb-4 mb-md-0">
                    <h6 class="fw-bold text-uppercase text-body mb-3" style="font-size: 0.85rem; letter-spacing: 0.5px;">Navegação</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-1 mb-0">
                        <li><a asp-controller="Home" asp-action="Index" class="footer-nav-link">Início</a></li>
                        <li><a asp-controller="Favorites" asp-action="Index" class="footer-nav-link">Meus Favoritos</a></li>
                        <li><a asp-controller="Cart" asp-action="Index" class="footer-nav-link">Meu Carrinho</a></li>
                        <li><a asp-controller="Order" asp-action="Index" class="footer-nav-link">Meus Pedidos</a></li>
                    </ul>
                </div>

                <!-- Coluna 3: Atendimento e Pagamento -->
                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold text-uppercase text-body mb-3" style="font-size: 0.85rem; letter-spacing: 0.5px;">Atendimento</h6>
                    <ul class="list-unstyled small d-flex flex-column gap-2 mb-4">
                        <li class="text-muted d-flex align-items-center gap-2">
                            <i class="bi bi-clock"></i> Seg a Sex: 09h às 18h
                        </li>
                        <li class="text-muted d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check text-success"></i> Compra 100% Segura
                        </li>
                    </ul>

                    <h6 class="fw-bold text-uppercase text-body mb-2" style="font-size: 0.85rem; letter-spacing: 0.5px;">Pagamento</h6>
                    <div class="d-flex gap-3 fs-4 text-muted">
                        <i class="bi bi-qr-code" title="Pix"></i>
                        <i class="bi bi-credit-card" title="Cartão de Crédito"></i>
                    </div>
                </div>

            </div>

            <!-- Linha inferior com direitos autorais -->
            <hr class="my-4 opacity-25">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small text-muted">
                <span>&copy; 2026 - Ateliê dos Pontinhos. Todos os direitos reservados.</span>
                <span class="mt-2 mt-md-0">Feito com <i class="bi bi-heart-fill text-danger mx-1" style="color: #b84a75 !important;"></i> para você</span>
            </div>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Script Robusto do Tema com LocalStorage -->
    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const themeToggleBtn = document.getElementById("btn-theme-toggle");
                const themeIcon = document.getElementById("theme-icon");
                const htmlElement = document.documentElement;

                const currentTheme = htmlElement.getAttribute("data-bs-theme");
                if (currentTheme === "dark") {
                    themeIcon.classList.replace("bi-moon-fill", "bi-sun-fill");
                } else {
                    themeIcon.classList.replace("bi-sun-fill", "bi-moon-fill");
                }

                if (themeToggleBtn) {
                    themeToggleBtn.addEventListener("click", function () {
                        const activeTheme = htmlElement.getAttribute("data-bs-theme");

                        if (activeTheme === "dark") {
                            htmlElement.setAttribute("data-bs-theme", "light");
                            localStorage.setItem("theme", "light");
                            themeIcon.classList.replace("bi-sun-fill", "bi-moon-fill");
                        } else {
                            htmlElement.setAttribute("data-bs-theme", "dark");
                            localStorage.setItem("theme", "dark");
                            themeIcon.classList.replace("bi-moon-fill", "bi-sun-fill");
                        }
                    });
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>